<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uam_bringup</name>
  <version>0.1.0</version>
  <description>Role-based launch wrappers for single-machine and split Jetson/laptop UAM arm deployments.</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>arm_geomagic_teleop</exec_depend>
  <exec_depend>arm_moveit_config</exec_depend>
  <exec_depend>arm_realtime_tracker</exec_depend>
  <exec_depend>easy_handeye2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>my_arm_hardware</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ros2_aruco</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
