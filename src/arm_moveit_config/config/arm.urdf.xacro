<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_fake_hardware" default="true" />
    <xacro:arg name="serial_port" default="/dev/ttyACM0" />
    <xacro:arg name="reader_port" default="/dev/ttyUSB5" />
    <xacro:arg name="gripper_port" default="/dev/ttyUSB6" />
    <xacro:arg name="baudrate" default="230400" />
    <xacro:arg name="gripper_baudrate" default="115200" />
    <xacro:arg name="position_scale" default="1000" />
    <xacro:arg name="arm_joint_signs" default="1,1,-1,1,1,1" />
    <xacro:arg name="arm_joint_offsets" default="0,0,0,0,0,0" />
    <xacro:arg name="hw_slowdown" default="10" />
    <xacro:arg name="initial_read_timeout_sec" default="2.0" />
    <xacro:arg name="first_power_on" default="true" />
    <xacro:arg name="aux_joint_min" default="-0.69" />
    <xacro:arg name="aux_joint_max" default="0.0" />
    <xacro:arg name="arm_command_frame_format" default="legacy_position" />
    <xacro:arg name="stm32_control_mode" default="0" />
    <xacro:arg name="stm32_kp" default="50,50,50,50,50,50" />
    <xacro:arg name="stm32_kd" default="2,2,2,2,2,2" />
    <xacro:arg name="stm32_v_des_limits_rad_s" default="1,1,1,1,1,1" />
    <xacro:arg name="stm32_heartbeat_duration_sec" default="1.0" />
    <xacro:arg name="stm32_trigger_duration_sec" default="3.0" />
    <xacro:arg name="stm32_feedback_wait_timeout_sec" default="2.0" />
    <xacro:arg name="enable_stm32_zero_trigger" default="false" />
    <xacro:arg name="stm32_recover_safe_drop_on_start" default="true" />
    <xacro:arg name="stm32_recover_duration_sec" default="0.25" />
    <xacro:arg name="stm32_trace_enabled" default="false" />
    <xacro:arg name="stm32_trace_directory" default="/tmp/arm_stm32_traces" />
    <xacro:arg name="stm32_trace_run_label" default="" />
    <xacro:arg name="stm32_trace_file" default="" />
    <xacro:arg name="stm32_trace_append" default="false" />
    <xacro:arg name="stm32_trace_decimation" default="1" />
    <xacro:arg name="enable_dynamics_feedforward" default="false" />
    <xacro:arg name="dynamics_mode" default="gravity" />
    <xacro:arg name="dynamics_urdf_path" default="" />
    <xacro:arg name="dynamics_feedforward_source" default="topic" />
    <xacro:arg name="dynamics_feedforward_topic" default="/arm_dynamics/torques_nm" />
    <xacro:arg name="dynamics_topic_timeout_sec" default="0.25" />
    <xacro:arg name="dynamics_use_commanded_position" default="false" />
    <xacro:arg name="dynamics_torque_scale" default="1.0" />
    <xacro:arg name="dynamics_torque_limits_nm" default="0.5,0.5,0.3,0.2,0.15,0.1" />
    <xacro:arg name="dynamics_torque_joint_signs" default="" />
    <xacro:arg name="dynamics_torque_low_pass_alpha" default="0.2" />
    <!-- Import the modular arm + selected gripper model. -->
    <xacro:include filename="$(find arm)/urdf/arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="arm.ros2_control.xacro" />

    <!-- World boxes (keep-outs / environment) -->
    <xacro:include filename="$(find arm)/urdf/virtual_walls.xacro"/>

    <!-- add limits -->
    <xacro:add_world_box
      name="limit_z_max"
      parent_link="uav_mount"
      xyz="0 0 0.005"                
      rpy="0 0 0"
      size="0.4 0.64 0.01"            
      color="0.9 0.1 0.1 0.2"
      collision_only="false"/>

    <xacro:add_world_box
      name="limit_y_min"
      parent_link="uav_mount"
      xyz="0 -0.32 -0.75"                
      rpy="1.57 0 0"
      size="0.4 1.6 0.01"            
      color="0.9 0.1 0.1 0.2"
      collision_only="false"/>

    <xacro:add_world_box
      name="limit_y_max"
      parent_link="uav_mount"
      xyz="0 0.32 -0.75"                
      rpy="1.57 0 0"
      size="0.4 1.6 0.01"            
      color="0.9 0.1 0.1 0.2"
      collision_only="false"/>
    
    <xacro:arm_ros2_control
      name="ArmSystem"
      initial_positions_file="$(arg initial_positions_file)"
      use_fake_hardware="$(arg use_fake_hardware)"
      serial_port="$(arg serial_port)"
      reader_port="$(arg reader_port)"
      gripper_port="$(arg gripper_port)"
      baudrate="$(arg baudrate)"
      gripper_baudrate="$(arg gripper_baudrate)"
      position_scale="$(arg position_scale)"
      arm_joint_signs="$(arg arm_joint_signs)"
      arm_joint_offsets="$(arg arm_joint_offsets)"
      hw_slowdown="$(arg hw_slowdown)"
      initial_read_timeout_sec="$(arg initial_read_timeout_sec)"
      first_power_on="$(arg first_power_on)"
      aux_joint_min="$(arg aux_joint_min)"
      aux_joint_max="$(arg aux_joint_max)"
      arm_command_frame_format="$(arg arm_command_frame_format)"
      stm32_control_mode="$(arg stm32_control_mode)"
      stm32_kp="$(arg stm32_kp)"
      stm32_kd="$(arg stm32_kd)"
      stm32_v_des_limits_rad_s="$(arg stm32_v_des_limits_rad_s)"
      stm32_heartbeat_duration_sec="$(arg stm32_heartbeat_duration_sec)"
      stm32_trigger_duration_sec="$(arg stm32_trigger_duration_sec)"
      stm32_feedback_wait_timeout_sec="$(arg stm32_feedback_wait_timeout_sec)"
      enable_stm32_zero_trigger="$(arg enable_stm32_zero_trigger)"
      stm32_recover_safe_drop_on_start="$(arg stm32_recover_safe_drop_on_start)"
      stm32_recover_duration_sec="$(arg stm32_recover_duration_sec)"
      stm32_trace_enabled="$(arg stm32_trace_enabled)"
      stm32_trace_directory="$(arg stm32_trace_directory)"
      stm32_trace_run_label="$(arg stm32_trace_run_label)"
      stm32_trace_file="$(arg stm32_trace_file)"
      stm32_trace_append="$(arg stm32_trace_append)"
      stm32_trace_decimation="$(arg stm32_trace_decimation)"
      enable_dynamics_feedforward="$(arg enable_dynamics_feedforward)"
      dynamics_mode="$(arg dynamics_mode)"
      dynamics_urdf_path="$(arg dynamics_urdf_path)"
      dynamics_feedforward_source="$(arg dynamics_feedforward_source)"
      dynamics_feedforward_topic="$(arg dynamics_feedforward_topic)"
      dynamics_topic_timeout_sec="$(arg dynamics_topic_timeout_sec)"
      dynamics_use_commanded_position="$(arg dynamics_use_commanded_position)"
      dynamics_torque_scale="$(arg dynamics_torque_scale)"
      dynamics_torque_limits_nm="$(arg dynamics_torque_limits_nm)"
      dynamics_torque_joint_signs="$(arg dynamics_torque_joint_signs)"
      dynamics_torque_low_pass_alpha="$(arg dynamics_torque_low_pass_alpha)"/>

</robot>
