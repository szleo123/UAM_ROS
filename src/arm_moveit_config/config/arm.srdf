<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="arm">
    <group name="arm">
        <chain base_link="base_link" tip_link="tool0"/>
    </group>
    <group name="gripper">
        <joint name="tool_joint"/>
        <link name="tool_base"/>
        <link name="tool_link"/>
    </group>

    <group_state name="zero" group="arm">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="0"/>
        <joint name="joint_3" value="0"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="0"/>
        <joint name="joint_6" value="0"/>
    </group_state>
    <group_state name="extend" group="arm">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="3.14"/>
        <joint name="joint_3" value="-3.14"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="1.57"/>
        <joint name="joint_6" value="1.57"/>
    </group_state>
    <group_state name="vertical" group="arm">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="1.57"/>
        <joint name="joint_3" value="-3.14"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="1.57"/>
        <joint name="joint_6" value="1.57"/>
    </group_state>
    <group_state name="approach" group="arm">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="1.57"/>
        <joint name="joint_3" value="-1.57"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="1.57"/>
        <joint name="joint_6" value="1.57"/>
    </group_state>
    <group_state name="test1" group="arm">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="2.0944"/>
        <joint name="joint_3" value="-1.309"/>
        <joint name="joint_4" value="-1.57"/>
        <joint name="joint_5" value="0.785398"/>
        <joint name="joint_6" value="1.57"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="tool_joint" value="0.0"/>
    </group_state>
    <group_state name="close" group="gripper">
        <joint name="tool_joint" value="-0.69"/>
    </group_state>

    <virtual_joint name="world_base" type="fixed" parent_frame="world" child_link="uav_mount"/>

    <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link_2" reason="Never"/>
    <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
    <disable_collisions link1="link_1" link2="link_3" reason="Never"/>
    <disable_collisions link1="link_1" link2="link_4" reason="Never"/>
    <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
    <disable_collisions link1="link_2" link2="link_4" reason="Never"/>
    <disable_collisions link1="link_2" link2="link_5" reason="Never"/>
    <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_5" reason="Never"/>
    <disable_collisions link1="link_3" link2="link_6" reason="Never"/>
    <disable_collisions link1="link_3" link2="tool_base" reason="Never"/>
    <disable_collisions link1="link_3" link2="tool_link" reason="Never"/>
    <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
    <disable_collisions link1="link_4" link2="tool_base" reason="Never"/>
    <disable_collisions link1="link_4" link2="tool_link" reason="Never"/>
    <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="tool_base" reason="Never"/>
    <disable_collisions link1="link_5" link2="tool_link" reason="Never"/>
    <disable_collisions link1="link_6" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="link_6" link2="tool_base" reason="Adjacent"/>
    <disable_collisions link1="link_6" link2="tool_link" reason="Never"/>
    <disable_collisions link1="tool_base" link2="tool_link" reason="Adjacent"/>
    <disable_collisions link1="tool0" link2="tool_base" reason="Adjacent"/>
    <disable_collisions link1="tool0" link2="tool_link" reason="Adjacent"/>
    <disable_collisions link1="link_4" link2="link_6" reason="Never"/>
</robot>
